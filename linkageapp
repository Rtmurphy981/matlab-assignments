    methods (Access = private)
        
        function pts = circleCircleIntersection(app,c1,r1,c2,r2)
            % declare symbolic variables
            syms x y

            % build equations
            eq1 = (x - c1(1))^2 + (y - c1(2))^2 == r1^2;
            eq2 = (x - c2(1))^2 + (y - c2(2))^2 == r2^2;

            % solve symbolically
            S = solve([eq1, eq2], [x, y]);

            % handle empty/failed solve
            if isempty(fieldnames(S))
                pts = [];
                return;
            end

            sx = S.x;
            sy = S.y;

            % ensure column vectors
            sx = sx(:);
            sy = sy(:);

            % keep only solutions that are symbolically real
            isRealX = arrayfun(@(e) isAlways(imag(e) == 0), sx);
            isRealY = arrayfun(@(e) isAlways(imag(e) == 0), sy);
            realIdx = find(isRealX & isRealY);

            if isempty(realIdx)
                pts = [];
                return;
            end

            % convert to double and form output
            try
                xs = double(sx(realIdx));
                ys = double(sy(realIdx));
            catch
                % if conversion fails (rare), return empty
                pts = [];
                return;
            end

            pts = [xs, ys];

        end
        
function chosen = chooseClosestPoint(app, pts, ref)
    if isempty(pts)
        chosen = [];
        return;
    end
    dists = sqrt(sum((pts - ref).^2, 2));
    [~, idx] = min(dists);
    chosen = pts(idx, :);
end
            
        
    end
    

