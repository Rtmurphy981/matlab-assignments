        % Button pushed function: ComputepositionAnalysisButton2
        function circleintersection2(app, event)
        
    app.ProgressLamp_2.Color = 'blue';
    app.ProgressLamp_2Label.Text = 'In Progress';
    drawnow;

    % Input points
    A = [app.AxEditField_2.Value app.AyEditField_2.Value 0];
    B = [app.BxEditField_2.Value app.ByEditField_2.Value 0];
    C = [app.CxEditField_2.Value app.CyEditField_2.Value 0];
    D = [app.DxEditField_2.Value app.DyEditField_2.Value 0];
    E = [app.ExEditField.Value app.EyEditField.Value 0];
    F = [app.FxEditField.Value app.FyEditField.Value 0];

    % Fixed point G
    G = [0.5 0.6 0];

    % Compute the initial angle of link AB, input link
    initial_angle_AB = atan2(B(2)-A(2), B(1)-A(1));

    if initial_angle_AB < 0
        initial_angle_AB = initial_angle_AB + 2*pi;
    end

    % Initial values
    app.new_B_joint_x(1) = B(1);
    app.new_B_joint_y(1) = B(2);

    app.new_C_joint_x(1) = C(1);
    app.new_C_joint_y(1) = C(2);

    app.new_E_joint_x(1) = E(1);
    app.new_E_joint_y(1) = E(2);

    app.new_F_joint_x(1) = F(1);
    app.new_F_joint_y(1) = F(2);

    % Compute link lengths
    AB = norm(A-B);
    BC = norm(B-C);
    CD = norm(C-D);

    BE = norm(B-E);
    CE = norm(C-E);

    EF = norm(E-F);
    FG = norm(F-G);

    app.lastIdx = 1;

    for theta = 1:1:360

        % Update B position
        B_new = A + [AB*cos(initial_angle_AB + deg2rad(theta)), ...
                     AB*sin(initial_angle_AB + deg2rad(theta)), 0];

        app.new_B_joint_x(theta+1) = B_new(1);
        app.new_B_joint_y(theta+1) = B_new(2);

        
        % Find C intersection of circle(B_new, BC) and circle(D, CD)
        ptsC = app.circleCircleIntersection( ...
            B_new(1:2), BC, D(1:2), CD);

        if isempty(ptsC)
            fprintf('New Position of C cannot be determined at angle: %d degree\n', theta);
            break;
        end

        C_new = app.chooseClosestPoint(ptsC, C(1:2));

        app.new_C_joint_x(theta+1) = C_new(1);
        app.new_C_joint_y(theta+1) = C_new(2);

        
        % Find E intersection of circle(B_new, BE) and circle(C_new, CE)
        
        ptsE = app.circleCircleIntersection( ...
            B_new(1:2), BE, C_new, CE);

        if isempty(ptsE)
            fprintf('New Position of E cannot be determined at angle: %d degree\n', theta);
            break;
        end

        E_new = app.chooseClosestPoint(ptsE, E(1:2));

        app.new_E_joint_x(theta+1) = E_new(1);
        app.new_E_joint_y(theta+1) = E_new(2);

        
        % Find F intersection of circle(E_new, EF) and circle(G, FG)
        
        ptsF = app.circleCircleIntersection( ...
            E_new, EF, G(1:2), FG);

        if isempty(ptsF)
            fprintf('New Position of F cannot be determined at angle: %d degree\n', theta);
            break;
        end

        F_new = app.chooseClosestPoint(ptsF, F(1:2));

        app.new_F_joint_x(theta+1) = F_new(1);
        app.new_F_joint_y(theta+1) = F_new(2);

        
        % Update chain for next iteration
        
        B = B_new;
        C = [C_new 0];
        E = [E_new 0];
        F = [F_new 0];

        app.lastIdx = theta + 1;

    end

    
    % Trim arrays to calculated positions
    
    app.new_B_joint_x = app.new_B_joint_x(1:app.lastIdx);
    app.new_B_joint_y = app.new_B_joint_y(1:app.lastIdx);

    app.new_C_joint_x = app.new_C_joint_x(1:app.lastIdx);
    app.new_C_joint_y = app.new_C_joint_y(1:app.lastIdx);

    app.new_E_joint_x = app.new_E_joint_x(1:app.lastIdx);
    app.new_E_joint_y = app.new_E_joint_y(1:app.lastIdx);

    app.new_F_joint_x = app.new_F_joint_x(1:app.lastIdx);
    app.new_F_joint_y = app.new_F_joint_y(1:app.lastIdx);

    
    
    
    app.ProgressLamp_2.Color = 'g';
    app.ProgressLamp_2Label.Text = 'Done';

    app.ShowmovementButton_2.Enable = "on";
    app.DownloaddataButton_2.Enable = "on";

        end

