        % Button pushed function: ComputepositionAnalysisButton
        function circleintersection(app, event)
            app.ProgressLamp.Color = 'blue';
            app.ProgressLampLabel.Text = 'In Progress';
            drawnow;

                A=[app.AxEditField.Value app.AyEditField.Value 0];
                B=[app.BxEditField.Value app.ByEditField.Value 0];
                C=[app.CxEditField.Value app.CyEditField.Value 0];
                D=[app.DxEditField.Value app.DyEditField.Value 0];

                % compute the initial angle of link AB, input link
                initial_angle_AB = atan2(B(2)-A(2), B(1)-A(1));
                if initial_angle_AB < 0
                    initial_angle_AB = initial_angle_AB + 2*pi;
                end

                % initial values (index 1)
                app.new_B_joint_x(1) = B(1); app.new_B_joint_y(1) = B(2);
                app.new_C_joint_x(1) = C(1); app.new_C_joint_y(1) = C(2);

                AB = norm(A-B);
                BC = norm(B-C);
                CD = norm(C-D);

                app.lastIdx = 1;

                for theta = 1:1:360
                    % update B position
                    B_new = A + [AB*cos(initial_angle_AB + deg2rad(theta)), ...
                        AB*sin(initial_angle_AB + deg2rad(theta)), 0];
                    app.new_B_joint_x(theta+1) = B_new(1);
                    app.new_B_joint_y(theta+1) = B_new(2);
                    app.lastIdx = theta;

                    % Find C intersection of circle(B_new, BC) and circle(CD)
                    ptsC = app.circleCircleIntersection(B_new(1:2), BC, D(1:2), CD);
                    if isempty(ptsC)
                        fprintf('New Position of C cannot be determined at angle: %d degree\n', theta);
                        break;
                    end

                    C_new = app.chooseClosestPoint(ptsC, C(1:2));
                    app.new_C_joint_x(theta+1) = C_new(1);
                    app.new_C_joint_y(theta+1) = C_new(2);

                    % update chain for next iteration
                    B = B_new;
                    C = [C_new 0];
                end

                app.new_B_joint_x = app.new_B_joint_x(1:app.lastIdx);
                app.new_B_joint_y = app.new_B_joint_y(1:app.lastIdx);
                app.new_C_joint_x = app.new_C_joint_x(1:app.lastIdx);
                app.new_C_joint_y = app.new_C_joint_y(1:app.lastIdx);
                app.ProgressLamp.Color = 'g';
                app.ProgressLampLabel.Text = 'Done';

app.ShowmovementButton.Enable = "on";
app.DownloaddataButton.Enable = "on";

        end

        % Button pushed function: ShowmovementButton
        function showMovement(app, event)
            cla(app.UIAxes);
            hold(app.UIAxes, 'on');

            %% 1. Initialize Animated Trajectory Lines (Targeting app.UIAxes)
            hTrajB = animatedline(app.UIAxes, 'Color', 'black', 'LineStyle', '-', 'LineWidth', 1.5);
            hTrajC = animatedline(app.UIAxes, 'Color', 'magenta', 'LineStyle', '-', 'LineWidth', 1.5);

            plot(app.UIAxes, app.DxEditField.Value, app.DyEditField.Value, 'rs', 'MarkerFaceColor', 'r');
            plot(app.UIAxes, app.DxEditField.Value, app.DyEditField.Value, 'rs', 'MarkerFaceColor', 'r');

            %% Links (initial coordinates at k = 1)
            hAB = plot(app.UIAxes, [app.AxEditField.Value, app.new_B_joint_x(1)], [app.AyEditField.Value, app.new_B_joint_y(1)], 'r-', 'LineWidth', 2);
            hBC = plot(app.UIAxes, [app.new_B_joint_x(1), app.new_C_joint_x(1)], [app.new_B_joint_y(1), app.new_C_joint_y(1)], 'g-', 'LineWidth', 2);
            hCD = plot(app.UIAxes, [app.new_C_joint_x(1), app.DxEditField.Value], [app.new_C_joint_y(1), app.DyEditField.Value], 'b-', 'LineWidth', 2);

            %% Joint Markers
            hB = plot(app.UIAxes, app.new_B_joint_x(1), app.new_B_joint_y(1), 'bo', 'MarkerFaceColor', 'b');
            hC = plot(app.UIAxes, app.new_C_joint_x(1), app.new_C_joint_y(1), 'bo', 'MarkerFaceColor', 'b');

            %% 3. Configure Legend & Axis Limits
            legend(app.UIAxes, {'Joint B Traj', 'Joint C Traj', 'Joint A', 'Joint D', 'link AB', 'Link BC', 'Link CD'}, 'Location', 'bestoutside');

            %% Calculate fixed bounds so axes don't jump during animation
            allx = [app.AxEditField.Value, app.DxEditField.Value, app.new_B_joint_x(1), app.new_C_joint_x(1)];
            ally = [app.AyEditField.Value, app.DyEditField.Value, app.new_B_joint_y(1), app.new_C_joint_y(1)];
            xmin = min(allx(:)) - 5; xmax = max(allx(:)) + 5;
            ymin = min(ally(:)) - 5; ymax = max(ally(:)) + 5;
            axis(app.UIAxes, [xmin xmax ymin ymax]);

            for k = 1:1:app.lastIdx
                % Update linkage segments
                set(hAB, 'XData', [app.AxEditField.Value, app.new_B_joint_x(k)], 'YData', [app.AyEditField.Value, app.new_B_joint_y(k)]);
                set(hBC, 'XData', [app.new_B_joint_x(k), app.new_C_joint_x(k)], 'YData', [app.new_B_joint_y(k), app.new_C_joint_y(k)]);
                set(hCD, 'XData', [app.new_C_joint_x(k), app.DxEditField.Value], 'YData', [app.new_C_joint_y(k), app.DyEditField.Value]);

                % Update moving joint markers
                set(hB, 'XData', app.new_B_joint_x(k), 'YData', app.new_B_joint_y(k));
                set(hC, 'XData', app.new_C_joint_x(k), 'YData', app.new_C_joint_y(k));

                % Append trajectory paths
                addpoints(hTrajB, app.new_B_joint_x(k), app.new_B_joint_y(k));
                addpoints(hTrajC, app.new_C_joint_x(k), app.new_C_joint_y(k));

                % Refresh App UI frame smoothly
                drawnow limitrate;
                pause(0.01); 
            end

            hold(app.UIAxes, 'off');

        end

